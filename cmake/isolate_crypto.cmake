# Keep the bundled TLS implementation private to Murmur. Rewrite definitions
# and references together, including data symbols and PSA entry points.
foreach(required ARCHIVE NM OBJCOPY)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
execute_process(COMMAND "${NM}" -g --defined-only "${ARCHIVE}"
  OUTPUT_VARIABLE symbols ERROR_VARIABLE diagnostics RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect crypto symbols: ${diagnostics}")
endif()
string(REPLACE "\n" ";" lines "${symbols}")
set(names)
foreach(line IN LISTS lines)
  if(line MATCHES "[ \t]((mbedtls_|psa_)[A-Za-z0-9_]+)$")
    list(APPEND names "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(REMOVE_DUPLICATES names)
if(NOT names)
  message(FATAL_ERROR "No bundled TLS symbols found; refusing an unverified archive")
endif()
set(mapping "${ARCHIVE}.crypto-symbols")
file(WRITE "${mapping}" "")
foreach(name IN LISTS names)
  file(APPEND "${mapping}" "${name} murmur_${name}\n")
endforeach()
execute_process(COMMAND "${OBJCOPY}" "--redefine-syms=${mapping}" "${ARCHIVE}"
  RESULT_VARIABLE result ERROR_VARIABLE diagnostics)
file(REMOVE "${mapping}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot isolate crypto symbols: ${diagnostics}")
endif()
execute_process(COMMAND "${NM}" -g --defined-only "${ARCHIVE}"
  OUTPUT_VARIABLE checked RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR checked MATCHES "[ \t](mbedtls_|psa_)[A-Za-z0-9_]+[\r\n]")
  message(FATAL_ERROR "Archive still exports unprefixed TLS symbols")
endif()
