enable_testing()
add_executable(murmur-platform-net tests/platform/net.c deps/murmur/platform_net.c)
target_include_directories(murmur-platform-net PRIVATE deps/murmur)
if(WIN32)
  target_link_libraries(murmur-platform-net PRIVATE ws2_32)
endif()
add_test(NAME platform-net COMMAND murmur-platform-net)
if(WIN32)
  add_executable(murmur-platform-file tests/platform/file.c deps/murmur/platform_file.c)
  target_include_directories(murmur-platform-file PRIVATE deps/murmur)
  add_test(NAME platform-file COMMAND murmur-platform-file)
endif()
# Existing dependency-free protocol/scheduler suites run on both OSes.
foreach(suite member framing msgcodec filecodec)
  set(sources deps/murmur/member.c deps/murmur/${suite}_selftest.c)
  if(NOT suite STREQUAL "member")
    list(APPEND sources deps/murmur/${suite}.c)
  endif()
  if(suite STREQUAL "filecodec")
    list(APPEND sources deps/murmur/msgcodec.c deps/murmur/postcard.c)
  endif()
  add_executable(murmur-test-${suite} ${sources})
  target_include_directories(murmur-test-${suite} PRIVATE deps/murmur deps/sqlite)
  if(WIN32)
    target_link_libraries(murmur-test-${suite} PRIVATE ws2_32)
  endif()
  add_test(NAME ${suite} COMMAND murmur-test-${suite})
  set_tests_properties(${suite} PROPERTIES WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}")
endforeach()
find_package(Threads REQUIRED)
add_executable(murmur-test-scheduler deps/murmur/scheduler.cc deps/murmur/scheduler_selftest.cc)
target_include_directories(murmur-test-scheduler PRIVATE deps/murmur deps/sqlite)
target_link_libraries(murmur-test-scheduler PRIVATE Threads::Threads)
add_test(NAME scheduler COMMAND murmur-test-scheduler)
